#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

ROOT_SPEC=
ROOT=
ROOTFSTYPE=ext4
BOOTFS_SPEC=PARTLABEL=bootfs
NFSROOT=
UBI_MTD=
UBI_DEV=
UBI_VOL=
K3_OVERLAYROOT=0
K3_BOOTFS_MODULES=0
K3_SD_CARD_UPGRADE_POST_INSTALL=0
init=/sbin/init

log()
{
	echo "k3-init: $*"
}

emergency_shell()
{
	log "$*"
	log "Starting an emergency shell"
	if [ -x /bin/bash ]; then
		shell=/bin/bash
		set -- --noprofile --norc -i
		PS1='k3-initramfs:\w# '
		export PS1
	else
		log "Warning: bash is unavailable; falling back to /bin/sh"
		shell=/bin/sh
		set -- -i
	fi

	if command -v setsid >/dev/null 2>&1 && [ -c /dev/console ]; then
		while :; do
			setsid -c "$shell" "$@" \
				</dev/console >/dev/console 2>&1
			log "Emergency shell exited; restarting"
			sleep 1
		done
	fi

	log "Warning: cannot attach the emergency shell to /dev/console"
	exec "$shell" "$@"
}

resolve_device()
{
	spec=$1
	case "$spec" in
		PARTUUID=*|UUID=*|PARTLABEL=*|LABEL=*)
			blkid -t "$spec" -o device 2>/dev/null | head -n 1
			;;
		/dev/*)
			printf '%s\n' "$spec"
			;;
		*)
			printf '%s\n' "$spec"
			;;
	esac
}

wait_for_device()
{
	spec=$1
	count=0
	while [ "$count" -lt 100 ]; do
		device=$(resolve_device "$spec")
		if [ -n "$device" ] && [ -b "$device" ]; then
			printf '%s\n' "$device"
			return 0
		fi
		sleep 0.1
		count=$((count + 1))
	done
	return 1
}

validate_root_init()
{
	root=$1
	run-init -n "$root" "$init" >/dev/null 2>&1
}

grow_rootfs()
{
	if [ "$ROOTFSTYPE" != "ext4" ]; then
		return 0
	fi

	log "Expanding the rootfs filesystem to fill its partition"
	if ! resize2fs "$ROOT"; then
		log "Warning: rootfs filesystem expansion failed; continuing boot"
	fi
}

load_overlay_config()
{
	config=/etc/k3-overlayroot.conf
	if [ -r "$config" ]; then
		. "$config"
	fi
	case "$K3_OVERLAYROOT" in
		0|1)
			;;
		*)
			emergency_shell "Invalid K3_OVERLAYROOT value: $K3_OVERLAYROOT"
			;;
	esac
}

load_bootfs_config()
{
	config=/etc/k3-bootfs.conf
	if [ -r "$config" ]; then
		. "$config"
	fi
	case "$K3_BOOTFS_MODULES" in
		0|1)
			;;
		*)
			emergency_shell "Invalid K3_BOOTFS_MODULES value: $K3_BOOTFS_MODULES"
			;;
	esac
}

load_sd_post_install_config()
{
	config=/etc/k3-sd-post-install.conf
	if [ -r "$config" ]; then
		. "$config"
	fi
	case "$K3_SD_CARD_UPGRADE_POST_INSTALL" in
		0|1)
			;;
		*)
			emergency_shell "Invalid K3_SD_CARD_UPGRADE_POST_INSTALL value: $K3_SD_CARD_UPGRADE_POST_INSTALL"
			;;
	esac
}

mount_bootfs()
{
	new_root=$1
	boot_device=$(wait_for_device "$BOOTFS_SPEC") || \
		emergency_shell "Bootfs device was not found: $BOOTFS_SPEC"
	if [ "$new_root" = "/" ]; then
		boot_mount=/boot
		modules_mount=/lib/modules
	else
		boot_mount=$new_root/boot
		modules_mount=$new_root/lib/modules
	fi

	log "Mounting bootfs read-only from $boot_device"
	mkdir -p "$boot_mount"
	mount -t ext4 -o ro,noload "$boot_device" "$boot_mount" || \
		emergency_shell "Bootfs mount failed"

	if [ "$K3_BOOTFS_MODULES" -eq 1 ]; then
		kernel_version=$(uname -r)
		boot_modules=$boot_mount/lib/modules/$kernel_version
		target_modules=$modules_mount/$kernel_version
		if [ ! -d "$boot_modules" ]; then
			emergency_shell "Bootfs kernel modules are missing: $boot_modules"
		fi
		mkdir -p "$target_modules"
		mount -n -o bind "$boot_modules" "$target_modules" || \
			emergency_shell "Cannot bind mount bootfs kernel modules"
	fi
}

finish_boot()
{
	mount_bootfs /rootfs
	validate_root_init /rootfs || emergency_shell "Rootfs init validation failed: $init"

	mkdir -p /rootfs/proc /rootfs/sys /rootfs/run /rootfs/dev
	mount -n -o move /proc /rootfs/proc || emergency_shell "Cannot move /proc"
	mount -n -o move /sys /rootfs/sys || emergency_shell "Cannot move /sys"
	mount -n -o move /run /rootfs/run || emergency_shell "Cannot move /run"
	mount -n -o move /dev /rootfs/dev || emergency_shell "Cannot move /dev"
	mount -t debugfs debugfs /rootfs/sys/kernel/debug 2>/dev/null || true

	exec run-init -c /dev/console /rootfs "$init" "$@" \
		< /rootfs/dev/console > /rootfs/dev/console 2>&1
	emergency_shell "run-init failed"
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
mkdir -p /dev/pts /dev/shm /tmp /run /rootfs /root-ro /userdata
mount -t devpts -o defaults,mode=644,ptmxmode=666 devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs -o mode=0755,nosuid,nodev,size=10% tmpfs /run
load_overlay_config
load_bootfs_config
load_sd_post_install_config

for argument in $(cat /proc/cmdline); do
	case "$argument" in
		init=*)
			init=${argument#init=}
			;;
		root=ubi*)
			UBI_ROOT=${argument#root=}
			UBI_DEV=$(echo "$UBI_ROOT" | cut -d ':' -f 1)
			UBI_VOL=$(echo "$UBI_ROOT" | cut -d ':' -f 2)
			UBI_DEV=${UBI_DEV#ubi}
			ROOT_SPEC=ubi
			;;
		root=*)
			ROOT_SPEC=${argument#root=}
			;;
		rootfstype=*)
			ROOTFSTYPE=${argument#rootfstype=}
			;;
		bootfs=*)
			BOOTFS_SPEC=${argument#bootfs=}
			;;
		ubi.mtd=*)
			UBI_MTD=${argument#ubi.mtd=}
			;;
		nfsroot=*)
			NFSROOT=${argument#nfsroot=}
			;;
	esac
done

if [ -z "$ROOT_SPEC" ]; then
	mount_bootfs /
	exec /sbin/init
fi

if [ "$ROOT_SPEC" = "/dev/nfs" ] && [ -n "$NFSROOT" ]; then
	/sbin/ifup -a
	mount -t nfs -o nolock "$NFSROOT" /rootfs || emergency_shell "NFS root mount failed"
	finish_boot "$@"
fi

if [ "$ROOT_SPEC" = "ubi" ] && [ -n "$UBI_MTD" ] && [ -n "$UBI_DEV" ] && [ -n "$UBI_VOL" ]; then
	if [ ! -e "/dev/ubi${UBI_DEV}" ]; then
		ubiattach -m "$UBI_MTD" -d "$UBI_DEV" || emergency_shell "UBI attach failed"
		sleep 1
	fi
	mount -t ubifs "ubi${UBI_DEV}:${UBI_VOL}" /rootfs || emergency_shell "UBIFS root mount failed"
	finish_boot "$@"
fi

ROOT=$(wait_for_device "$ROOT_SPEC") || emergency_shell "Root device was not found: $ROOT_SPEC"
if [ "$K3_OVERLAYROOT" -eq 1 ]; then
	log "Mounting rootfs read-only from $ROOT"
	mount -t "$ROOTFSTYPE" -o ro,noload "$ROOT" /rootfs || emergency_shell "Rootfs mount failed"
else
	log "Mounting rootfs read-write from $ROOT"
	mount -t "$ROOTFSTYPE" -o rw "$ROOT" /rootfs || emergency_shell "Rootfs mount failed"
	grow_rootfs
fi
validate_root_init /rootfs || emergency_shell "Rootfs init is missing or not executable: $init"

if [ "$K3_OVERLAYROOT" -eq 1 ]; then
	export K3_ROOT_DEVICE="$ROOT"
	export K3_ROOT_INIT="$init"
	if ! /sbin/k3-overlayroot; then
		emergency_shell "Overlay root setup failed"
	fi
	if [ "$K3_SD_CARD_UPGRADE_POST_INSTALL" -eq 1 ]; then
		USERDATA_PERSISTENT=0
		USERDATA_DEV=
		MISC_DEV=
		if [ -r /run/k3-overlayroot.state ]; then
			. /run/k3-overlayroot.state
		fi
		export K3_SD_CARD_UPGRADE_POST_INSTALL
		export USERDATA_PERSISTENT USERDATA_DEV MISC_DEV
		if ! /sbin/k3-sd-post-install; then
			emergency_shell "SD card post-install failed"
		fi
	fi
else
	log "Rootfs overlay is disabled by configuration"
fi

finish_boot "$@"
