
menu "Bianbu config"

config BR2_TARGET_K3_ROOTFS_OVERLAY
	bool "Enable the K3 rootfs overlay"
	help
	  Mount the root filesystem read-only and use the userdata
	  partition as the persistent OverlayFS upper layer. This also
	  enables the misc partition used to request a userdata reset.
	  When disabled, rootfs is the final partition and uses the
	  remaining block device space.

config BR2_TARGET_K3_BOOTFS_MODULES
	bool "Install Linux kernel modules in bootfs"
	depends on BR2_LINUX_KERNEL
	help
	  Install Linux kernel modules under /lib/modules in the bootfs
	  image instead of the target root filesystem. The initramfs mounts
	  bootfs at /boot and bind mounts /boot/lib/modules/<release> at
	  /lib/modules/<release> for the running kernel.

config BR2_TARGET_K3_BOOTFS_SIZE
	int "Bootfs partition size (MiB)"
	default 256
	range 1 4096
	help
	  Size of the bootfs partition and ext4 image in MiB. Partition
	  offsets after bootfs are adjusted to match this value.

