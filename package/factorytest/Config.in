config BR2_PACKAGE_FACTORYTEST
	bool "factorytest"
	help
	  Product line factory test suite.

if BR2_PACKAGE_FACTORYTEST

choice
	prompt "Board type"
	default BR2_PACKAGE_FACTORYTEST_BOARD_K3_PICO_ITX

config BR2_PACKAGE_FACTORYTEST_BOARD_K3_PICO_ITX
	bool "k3-pico-itx"

config BR2_PACKAGE_FACTORYTEST_BOARD_K3_COM260
	bool "k3-com260"

config BR2_PACKAGE_FACTORYTEST_BOARD_K3_COM260_KIT
	bool "k3-com260-kit"

config BR2_PACKAGE_FACTORYTEST_BOARD_K3_COM260_IFX
	bool "k3-com260-ifx"

config BR2_PACKAGE_FACTORYTEST_BOARD_K3_SLT
	bool "k3-slt"

endchoice

config BR2_PACKAGE_FACTORYTEST_BOARD
	string
	default "k3-pico-itx"    if BR2_PACKAGE_FACTORYTEST_BOARD_K3_PICO_ITX
	default "k3-com260"      if BR2_PACKAGE_FACTORYTEST_BOARD_K3_COM260
	default "k3-com260-kit"  if BR2_PACKAGE_FACTORYTEST_BOARD_K3_COM260_KIT
	default "k3-com260-ifx"  if BR2_PACKAGE_FACTORYTEST_BOARD_K3_COM260_IFX
	default "k3-slt"         if BR2_PACKAGE_FACTORYTEST_BOARD_K3_SLT

endif
