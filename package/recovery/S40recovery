#!/bin/sh
#
# Start Rockchip recovery for Linux...
#

case "$1" in
  start)
  		mount /dev/block/by-name/userdata /userdata/
  		if [ -f "userdata/firefly/dont_eraes" ];then
			/userdata/firefly/netMac.sh
			reboot
			exit 1
		elif [ -f "/userdata/firefly/firefly-recovery.sh" ];then
                        /userdata/firefly/firefly-recovery.sh
                        reboot
                        exit 1
		else
			umount /userdata
		fi
	  	touch /dev/.coldboot_done
		/usr/bin/recovery &

	;;
  stop)
		killall recovery
		printf "stop finished"
        ;;
  *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
exit 0
